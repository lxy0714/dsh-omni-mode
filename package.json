{
  "name": "dsh-omni-mode",
  "version": "1.6.0-dev.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxy0714/dsh-omni-mode.git"
  },
  "homepage": "https://github.com/lxy0714/dsh-omni-mode#readme",
  "bugs": {
    "url": "https://github.com/lxy0714/dsh-omni-mode/issues"
  },
  "type": "module",
  "description": "全能模式：跨项目、质量优先，支持能力感知推理与自适应信息保留。 / Omni mode: a quality-first DeepSeek Harness preset with capability-aware reasoning and adaptive retention.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "agent-preset",
    "omni-mode"
  ],
  "engines": {
    "dsh": "0.2.2-rc.1",
    "node": ">=24.9.0"
  },
  "exports": {
    ".": "./quality.js",
    "./adaptive": "./adaptive.js",
    "./pool": "./pool.js",
    "./pool/locale/*.json": "./locale/pool/*.json",
    "./pool/icon": "./icon.svg",
    "./adaptive/locale/*.json": "./locale/adaptive/*.json",
    "./adaptive/icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "quality.js",
    "adaptive.js",
    "pool.js",
    "cordis.patch.yml",
    "locale/**/*.json",
    "icon.svg",
    "skills/**/*.md",
    "skills/grilling/LICENSE",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "VERIFICATION.md",
    "docs/*.md"
  ],
  "scripts": {
    "test": "node --test quality.test.js adaptive.test.js omni-method.test.mjs scripts/benchmark/grader.test.mjs scripts/benchmark/summarize.test.mjs tools/benchmark-host/index.test.mjs",
    "test:host": "node integration.mjs",
    "check": "node scripts/check-docs.mjs && node scripts/verify-package.mjs",
    "pack:check": "node scripts/verify-package.mjs --pack",
    "verify": "npm run check && npm test && npm run test:host && npm run pack:check"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "yaml": "2.8.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
